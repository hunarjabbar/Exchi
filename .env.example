# Example for local/staging only. Set independently for each app in its process environment.
# Frontend processes: separate APP_ORIGIN (exact origin, no trailing slash) for every application.
APP_ORIGIN=https://command.example.invalid
ENTERPRISE_API_URL=http://127.0.0.1:4000
# API process only: restricted runtime login, not database owner or administrator.
RUNTIME_DATABASE_URL=postgresql://RESTRICTED_LOGIN:REPLACE_WITH_SECRET@127.0.0.1:55432/wholesale_test
PORT=4000
# Migration process only: separate owner/admin URL. Never expose to runtime/API or frontend.
DATABASE_URL=postgresql://MIGRATION_LOGIN:REPLACE_WITH_SECRET@127.0.0.1:55432/wholesale_test?schema=public
# Auth provider configuration (API process only). Default off; no production authorization implied.
AUTH_MODE=disabled
AUTH_LIVE_APPROVED=NO
ALLOW_LOCAL_DEV_OTP=NO
AUTH_OTP_HMAC_KEY=
AUTH_RETAILER_SIGNUP_TENANT=
AUTH_STAFF_TOTP_JSON={}
# Meta approved copy-code authentication template and currently supported Graph API version
META_GRAPH_VERSION=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_AUTH_TEMPLATE=
META_AUTH_LANGUAGE=en
# Optional SMS fallback channel; use approved sender/merchant account and authorized Iraqi delivery route
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Gate 1: local / staging / production; only local synthetic OTP is permitted.
RELEASE_ENV=local
FINANCIAL_EXECUTION=LOCKED
# Required for staging/production readiness. Not activated by this gate.
REDIS_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ZAINCASH_CLIENT_ID=
ZAINCASH_CLIENT_SECRET=
FIB_CLIENT_ID=
FIB_CLIENT_SECRET=
FASTPAY_STORE_ID=
FASTPAY_STORE_PASSWORD=
